{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anf_new_ticker_parity_matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "contract_name",
    "architectural_scope",
    "inventory_method",
    "formula_contract_version",
    "source_digests",
    "summary",
    "entries"
  ],
  "properties": {
    "$schema": {"const": "./anf_new_ticker_parity_matrix.schema.json"},
    "version": {"const": "1.2.0"},
    "contract_name": {"type": "string", "minLength": 1},
    "architectural_scope": {"type": "string", "minLength": 1},
    "inventory_method": {"type": "string", "minLength": 1},
    "formula_contract_version": {"type": "string", "minLength": 1},
    "source_digests": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entry_count", "required_count", "required_reproduced_count", "required_missing_count", "independent_source_fact_count", "independent_source_fact_reproduced_count", "inventory_class_counts", "formula_contract_counts", "formula_calculability_counts", "domain_status_counts"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 1},
        "required_count": {"type": "integer", "minimum": 1},
        "required_reproduced_count": {"type": "integer", "minimum": 0},
        "required_missing_count": {"type": "integer", "minimum": 0},
        "independent_source_fact_count": {"type": "integer", "minimum": 1},
        "independent_source_fact_reproduced_count": {"type": "integer", "minimum": 0},
        "inventory_class_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "formula_contract_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "formula_calculability_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "domain_status_counts": {"type": "object"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parity_id",
          "domain",
          "metric_business_meaning",
          "period",
          "dimensions",
          "legacy_sheet_range",
          "source_backed_vs_derived",
          "inventory_class",
          "inventory_origin",
          "legacy_value",
          "normalized_value",
          "unit",
          "comparison_result",
          "formula_contract_status",
          "economic_calculability",
          "calculation_reason",
          "disposition",
          "source_ref",
          "normalized_package_path",
          "binding_ids",
          "formula_ownership",
          "expected_new_workbook_destination",
          "minimum_coverage_requirement",
          "parity_requirement",
          "rejection_reason",
          "current_status"
        ],
        "properties": {
          "parity_id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "metric_business_meaning": {"type": "string", "minLength": 1},
          "period": {"type": "string"},
          "dimensions": {"type": "object"},
          "legacy_sheet_range": {"type": "string"},
          "source_backed_vs_derived": {"enum": ["source_backed", "derived", "unavailable"]},
          "inventory_class": {"enum": ["source_fact", "formula_improvement", "duplicate_display_use", "unsupported_legacy_content"]},
          "inventory_origin": {"type": "string", "minLength": 1},
          "legacy_value": {},
          "normalized_value": {},
          "unit": {"type": "string"},
          "comparison_result": {"type": "string"},
          "formula_contract_status": {"enum": ["not_applicable", "present_protected", "present_unprotected", "missing"]},
          "economic_calculability": {"enum": ["not_applicable", "economically_calculable", "blank_due_to_missing_evidence"]},
          "calculation_reason": {"type": "string"},
          "disposition": {"type": "string"},
          "source_ref": {"type": "string"},
          "normalized_package_path": {"type": "string"},
          "binding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "formula_ownership": {"type": "string", "minLength": 1},
          "expected_new_workbook_destination": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "minimum_coverage_requirement": {"type": "integer", "minimum": 1},
          "parity_requirement": {"enum": ["must_reproduce", "may_improve_semantically", "intentionally_rejected", "unavailable_missing_evidence"]},
          "rejection_reason": {"type": "string"},
          "current_status": {"enum": ["reproduced_correctly", "contract_present_blank_by_missing_evidence", "missing_or_explicitly_unavailable"]}
        }
      }
    }
  }
}
