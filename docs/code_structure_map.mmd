  subgraph Lifecycle["4. Data Lifecycle Map"]
    RawSource["Raw source<br/>SEC/XBRL, IR, transcripts,<br/>presentations, manual profile"]:::source
    ParsedEvidence["Parsed evidence<br/>facts, extracted snippets,<br/>source refs, confidence"]:::transform
