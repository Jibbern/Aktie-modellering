  subgraph RiskMap["5. Risk Map From GTX Stress Evidence"]
    GTXFailure["GTX dry-run failure mode<br/>template-clean workbook but sparse,<br/>generic, or wrong content"]:::risk
    TickerBranches["Ticker-specific writer branches"]:::risk
    PostRenderRepairs["Post-render scaffold / repair logic"]:::risk
    ParserNoise["Parser-noise snippets in visible UI"]:::risk
    GuidanceRisk["Guidance metric misclassification"]:::risk
    LayoutMutation["Layout mutation after render"]:::risk
    SilentBlanks["Missing-source blanks without reason"]:::risk

    NormalizeFirst["Prevent by normalized package<br/>statuses and source refs required"]:::future
    ValidateFirst["Prevent by pre-render validation<br/>block or flag before Excel render"]:::future
    FrozenShell["Prevent by frozen shell<br/>layout owned outside runtime"]:::future
    BindingOnly["Prevent by binding map<br/>value-only writable zones"]:::future
  end

  GTXFailure --> TickerBranches
  GTXFailure --> PostRenderRepairs
  GTXFailure --> ParserNoise
  GTXFailure --> GuidanceRisk
  GTXFailure --> LayoutMutation
  GTXFailure --> SilentBlanks
  TickerBranches -. avoided by .-> NormalizeFirst
  ParserNoise -. blocked by .-> ValidateFirst
  GuidanceRisk -. blocked by .-> ValidateFirst
  PostRenderRepairs -. replaced by .-> FrozenShell
  LayoutMutation -. blocked by .-> FrozenShell
  SilentBlanks -. explained by .-> BindingOnly
