{
  "$schema": "hidden_value_signal_contract.schema.json",
  "contract_version": "1.0.0",
  "plan_version": "1.0.0",
  "owner_module_id": "hidden_value_signals",
  "trusted_statuses": ["populated", "source_backed"],
  "states": [
    "triggered",
    "near_miss",
    "not_triggered",
    "unavailable",
    "insufficient_evidence",
    "invalid_input"
  ],
  "severity_bands": [
    {"severity": "high", "minimum_score": 70},
    {"severity": "medium", "minimum_score": 40},
    {"severity": "low", "minimum_score": 0}
  ],
  "metric_resolvers": [
    {"metric_id": "ebit_ttm", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "operating_income_ttm"}},
    {"metric_id": "ebit_ttm_prior_yoy", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "lagged", "input_metric_id": "ebit_ttm", "lag": 4}},
    {"metric_id": "ebit_growth_yoy", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "ebit_ttm", "prior_metric_id": "ebit_ttm_prior_yoy", "denominator_rule": "nonzero"}},
    {"metric_id": "base_ebitda_ttm", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "ebitda_ttm"}},
    {"metric_id": "base_ebitda_ttm_prior_yoy", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "lagged", "input_metric_id": "base_ebitda_ttm", "lag": 4}},
    {"metric_id": "base_ebitda_growth_yoy", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "base_ebitda_ttm", "prior_metric_id": "base_ebitda_ttm_prior_yoy", "denominator_rule": "nonzero"}},
    {"metric_id": "revenue_ttm", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "revenue_ttm"}},
    {"metric_id": "revenue_ttm_prior_yoy", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "lagged", "input_metric_id": "revenue_ttm", "lag": 4}},
    {"metric_id": "growth_base_minimum", "unit": "$m", "period_role": "derived", "resolver": {"kind": "max_constant_scaled", "scaled_metric_id": "revenue_ttm_prior_yoy", "constant": 10.0, "scale": 0.002}},
    {"metric_id": "shares_outstanding", "unit": "m shares", "period_role": "point_in_time", "resolver": {"kind": "source_metric", "source_metric_ids": ["shares_outstanding"], "disposition_path": "valuation_inputs.shares_outstanding"}},
    {"metric_id": "shares_outstanding_prior_yoy", "unit": "m shares", "period_role": "point_in_time", "resolver": {"kind": "lagged", "input_metric_id": "shares_outstanding", "lag": 4}},
    {"metric_id": "shares_outstanding_yoy", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "shares_outstanding", "prior_metric_id": "shares_outstanding_prior_yoy", "denominator_rule": "positive"}},
    {"metric_id": "adjusted_ebitda_ttm", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "adjusted_ebitda_ttm"}},
    {"metric_id": "adjusted_ebitda_margin_ttm", "unit": "%", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "adjusted_ebitda_margin_ttm"}},
    {"metric_id": "adjusted_ebitda_margin_ttm_prior_yoy", "unit": "%", "period_role": "ttm", "resolver": {"kind": "lagged", "input_metric_id": "adjusted_ebitda_margin_ttm", "lag": 4}},
    {"metric_id": "adjusted_ebitda_margin_yoy_bps", "unit": "bps", "period_role": "derived", "resolver": {"kind": "scaled_change", "current_metric_id": "adjusted_ebitda_margin_ttm", "prior_metric_id": "adjusted_ebitda_margin_ttm_prior_yoy", "scale": 10000}},
    {"metric_id": "adjusted_ebitda_margin_streak", "unit": "quarters", "period_role": "derived", "resolver": {"kind": "nondecreasing_streak", "input_metric_id": "adjusted_ebitda_margin_ttm", "max_periods": 20}},
    {"metric_id": "free_cash_flow_ttm", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "free_cash_flow_ttm"}},
    {"metric_id": "positive_fcf_ttm_observations", "unit": "observations", "period_role": "derived", "resolver": {"kind": "positive_window_count", "input_metric_id": "free_cash_flow_ttm", "window": 4}},
    {"metric_id": "fcf_to_ebit", "unit": "x", "period_role": "derived", "resolver": {"kind": "ratio", "numerator_metric_id": "free_cash_flow_ttm", "denominator_metric_id": "ebit_ttm", "denominator_rule": "positive"}},
    {"metric_id": "share_price", "unit": "$/share", "period_role": "point_in_time", "resolver": {"kind": "package_point", "path": "valuation_inputs.price", "period_path": "valuation_inputs.price.period"}},
    {"metric_id": "market_cap_explicit", "unit": "$m", "period_role": "point_in_time", "resolver": {"kind": "source_metric", "source_metric_ids": ["market_cap"]}},
    {"metric_id": "market_cap", "unit": "$m", "period_role": "point_in_time", "resolver": {"kind": "market_cap", "explicit_metric_id": "market_cap_explicit", "price_metric_id": "share_price", "shares_metric_id": "shares_outstanding", "allow_explicit_or_derived": true}},
    {"metric_id": "fcf_yield", "unit": "%", "period_role": "derived", "resolver": {"kind": "ratio", "numerator_metric_id": "free_cash_flow_ttm", "denominator_metric_id": "market_cap", "denominator_rule": "positive"}},
    {"metric_id": "net_debt", "unit": "$m", "period_role": "point_in_time", "resolver": {"kind": "source_metric", "source_metric_ids": ["net_debt"], "disposition_path": "debt_liquidity.net_debt"}},
    {"metric_id": "net_debt_prior_yoy", "unit": "$m", "period_role": "point_in_time", "resolver": {"kind": "lagged", "input_metric_id": "net_debt", "lag": 4}},
    {"metric_id": "net_debt_reduction", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "net_debt", "prior_metric_id": "net_debt_prior_yoy", "denominator_rule": "prior_positive", "scale": -1}},
    {"metric_id": "net_leverage", "unit": "x", "period_role": "derived", "resolver": {"kind": "ratio", "numerator_metric_id": "net_debt", "denominator_metric_id": "base_ebitda_ttm", "denominator_rule": "positive"}},
    {"metric_id": "interest_expense_ttm", "unit": "$m", "period_role": "ttm", "resolver": {"kind": "formula", "formula_id": "_interest_expense_ttm"}},
    {"metric_id": "interest_coverage", "unit": "x", "period_role": "derived", "resolver": {"kind": "ratio", "numerator_metric_id": "ebit_ttm", "denominator_metric_id": "interest_expense_ttm", "denominator_rule": "positive"}},
    {"metric_id": "free_cash_flow_per_share", "unit": "$/share", "period_role": "derived", "resolver": {"kind": "ratio", "numerator_metric_id": "free_cash_flow_ttm", "denominator_metric_id": "shares_outstanding", "denominator_rule": "positive"}},
    {"metric_id": "free_cash_flow_per_share_prior_yoy", "unit": "$/share", "period_role": "derived", "resolver": {"kind": "lagged", "input_metric_id": "free_cash_flow_per_share", "lag": 4}},
    {"metric_id": "free_cash_flow_per_share_yoy", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "free_cash_flow_per_share", "prior_metric_id": "free_cash_flow_per_share_prior_yoy", "denominator_rule": "nonzero"}},
    {"metric_id": "dividend_per_share", "unit": "$/share", "period_role": "quarter", "resolver": {"kind": "source_metric", "source_metric_ids": ["dividend_per_share"], "disposition_path": "capital_returns.dividends", "unavailable_disposition_statuses": ["missing_source"]}},
    {"metric_id": "dividend_per_share_prior_qoq", "unit": "$/share", "period_role": "quarter", "resolver": {"kind": "lagged", "input_metric_id": "dividend_per_share", "lag": 1}},
    {"metric_id": "dividend_per_share_prior_yoy", "unit": "$/share", "period_role": "quarter", "resolver": {"kind": "lagged", "input_metric_id": "dividend_per_share", "lag": 4}},
    {"metric_id": "dividend_per_share_qoq", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "dividend_per_share", "prior_metric_id": "dividend_per_share_prior_qoq", "denominator_rule": "nonzero"}},
    {"metric_id": "dividend_per_share_yoy", "unit": "%", "period_role": "derived", "resolver": {"kind": "relative_change", "current_metric_id": "dividend_per_share", "prior_metric_id": "dividend_per_share_prior_yoy", "denominator_rule": "nonzero"}},
    {"metric_id": "dividend_per_share_ttm", "unit": "$/share", "period_role": "ttm", "resolver": {"kind": "rolling_sum", "input_metric_id": "dividend_per_share", "window": 4}},
    {"metric_id": "dividend_yield", "unit": "%", "period_role": "derived", "resolver": {"kind": "ratio", "numerator_metric_id": "dividend_per_share_ttm", "denominator_metric_id": "share_price", "denominator_rule": "positive"}}
  ],
  "signals": [
    {
