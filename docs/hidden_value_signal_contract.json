      "optional_metric_ids": [],
      "eligibility": {"mode": "all", "predicates": [
        {"predicate_id": "prior_ebit_material", "metric_id": "ebit_ttm_prior_yoy", "operator": "gt", "right_metric_id": "growth_base_minimum"},
        {"predicate_id": "prior_ebitda_material", "metric_id": "base_ebitda_ttm_prior_yoy", "operator": "gt", "right_metric_id": "growth_base_minimum"}
      ]},
      "trigger": {"mode": "all", "predicates": [
        {"predicate_id": "ebit_growth", "metric_id": "ebit_growth_yoy", "operator": "gt", "threshold": 0.25},
        {"predicate_id": "ebitda_growth", "metric_id": "base_ebitda_growth_yoy", "operator": "gt", "threshold": 0.20},
        {"predicate_id": "share_reduction", "metric_id": "shares_outstanding_yoy", "operator": "lte", "threshold": -0.02}
      ]},
      "near_miss": {"mode": "all", "minimum_trigger_predicates": 2, "predicates": [
        {"predicate_id": "ebit_growth_near", "metric_id": "ebit_growth_yoy", "operator": "gte", "threshold": 0.20},
        {"predicate_id": "ebitda_growth_near", "metric_id": "base_ebitda_growth_yoy", "operator": "gte", "threshold": 0.15},
        {"predicate_id": "share_reduction_near", "metric_id": "shares_outstanding_yoy", "operator": "lte", "threshold": -0.01}
      ]},
      "score_components": [
        {"component_id": "ebit_growth_score", "metric_id": "ebit_growth_yoy", "weight": 40, "required": true, "normalization": {"method": "linear_clamped", "direction": "higher", "threshold": 0.25, "span": 0.50, "base": 0.30}},
        {"component_id": "ebitda_growth_score", "metric_id": "base_ebitda_growth_yoy", "weight": 40, "required": true, "normalization": {"method": "linear_clamped", "direction": "higher", "threshold": 0.20, "span": 0.40, "base": 0.30}},
        {"component_id": "share_reduction_score", "metric_id": "shares_outstanding_yoy", "weight": 20, "required": true, "normalization": {"method": "linear_clamped", "direction": "lower", "threshold": -0.02, "span": 0.05, "base": 0.20}}
