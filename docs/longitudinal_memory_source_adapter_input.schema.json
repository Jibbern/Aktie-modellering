{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-model-engine.local/schemas/longitudinal-memory-source-adapter-input.v1.json",
  "title": "Longitudinal Memory Source Adapter Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "source_set_id",
    "company_id",
    "knowledge_cutoff",
    "sector_pack_id",
    "ticker_profile_id",
    "normalized_package_ref",
    "profile",
    "reviewed_links",
    "periods",
    "documents",
    "required_assertions",
    "reviewed_model_inputs"
  ],
  "properties": {
    "schema_id": {"const": "longitudinal-memory-source-set"},
    "schema_version": {"const": "1.0.0"},
    "source_set_id": {"$ref": "#/$defs/nonEmpty"},
    "company_id": {"$ref": "#/$defs/companyId"},
    "knowledge_cutoff": {"$ref": "#/$defs/date"},
    "sector_pack_id": {"$ref": "#/$defs/semanticId"},
    "ticker_profile_id": {"$ref": "#/$defs/semanticId"},
    "normalized_package_ref": {"$ref": "#/$defs/normalizedPackageRef"},
    "profile": {"$ref": "#/$defs/profile"},
    "reviewed_links": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewedLink"}
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/periodSpec"}
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/documentSpec"}
    },
    "required_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/numericalAssertion"},
          {"$ref": "#/$defs/guidanceAssertion"},
          {"$ref": "#/$defs/promiseAssertion"},
          {"$ref": "#/$defs/statementAssertion"},
          {"$ref": "#/$defs/eventAssertion"},
          {"$ref": "#/$defs/periodEvidenceAssertion"}
        ]
      }
    },
    "reviewed_model_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewedModelInput"}
    },
    "review_issue_specs": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewIssueSpec"}
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "nullableDate": {"type": ["string", "null"], "format": "date"},
    "companyId": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,31}$"},
    "semanticId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)+@[1-9][0-9]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "reviewState": {"enum": ["accepted", "reviewed", "needs_review", "rejected"]},
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmpty"},
      "uniqueItems": true
    },
    "normalizedPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_snapshot_id", "source_package_schema_version", "source_package_company_id", "source_package_ref"],
      "properties": {
        "semantic_snapshot_id": {"$ref": "#/$defs/nonEmpty"},
        "source_package_schema_version": {"$ref": "#/$defs/nonEmpty"},
        "source_package_company_id": {"$ref": "#/$defs/companyId"},
        "source_package_ref": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "alias", "member_id"],
      "properties": {
        "axis": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "dimension_id": {"$ref": "#/$defs/semanticId"},
        "alias": {"$ref": "#/$defs/nonEmpty"},
        "member_id": {"$ref": "#/$defs/semanticId"}
      }
    },
    "reviewedHorizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_key", "anchor_period_key", "derivation_rule_id", "fiscal_calendar_id",
        "fiscal_year", "period_type", "fiscal_quarter", "fiscal_ordinal", "start_date",
        "end_date", "duration_days", "week_count", "review_state"
      ],
      "properties": {
        "period_key": {"$ref": "#/$defs/nonEmpty"},
        "anchor_period_key": {"$ref": "#/$defs/nonEmpty"},
        "derivation_rule_id": {"const": "rule:core:contiguous-reviewed-fiscal-horizon@1"},
        "fiscal_calendar_id": {"$ref": "#/$defs/semanticId"},
        "fiscal_year": {"type": "integer", "minimum": 1900},
        "period_type": {"const": "annual"},
        "fiscal_quarter": {"type": "null"},
        "fiscal_ordinal": {"type": "integer"},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "duration_days": {"type": "integer", "minimum": 1},
        "week_count": {"type": "integer", "minimum": 1},
        "review_state": {"const": "reviewed"}
      }
    },
    "reviewedCalendarRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "display_hint", "fiscal_label_basis", "quarters_per_year",
        "ordinal_anchor_fiscal_year", "ordinal_anchor_fiscal_quarter", "ordinal_anchor",
        "quarter_week_counts", "annual_week_counts", "fiscal_year_end_months",
        "reviewed_horizons"
      ],
      "properties": {
        "rule_id": {"enum": ["rule:core:source-labelled-52-53-week-fiscal@1", "rule:core:calendar-year-fiscal@1"]},
        "display_hint": {"$ref": "#/$defs/nonEmpty"},
        "fiscal_label_basis": {"const": "direct-source"},
        "quarters_per_year": {"const": 4},
        "ordinal_anchor_fiscal_year": {"type": "integer", "minimum": 1900},
        "ordinal_anchor_fiscal_quarter": {"type": "integer", "minimum": 1, "maximum": 4},
        "ordinal_anchor": {"type": "integer"},
        "quarter_week_counts": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "annual_week_counts": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "fiscal_year_end_months": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 12}
        },
        "reviewed_horizons": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/reviewedHorizon"}
        },
        "calendar_basis": {"enum": ["calendar-year", "source-labelled-52-53-week"]},
        "quarter_boundaries": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^Q[1-4]:[0-9]{2}-[0-9]{2}:[0-9]{2}-[0-9]{2}$"}
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "cik",
        "publisher_id",
        "publisher_aliases",
        "member_aliases",
        "activated_metric_ids",
        "official_host_aliases",
        "calendar_id",
        "calendar_hint",
        "reviewed_calendar_rule"
      ],
      "properties": {
        "company_id": {"$ref": "#/$defs/companyId"},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "publisher_id": {"$ref": "#/$defs/nonEmpty"},
        "publisher_aliases": {"$ref": "#/$defs/stringArray"},
        "member_aliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/alias"}},
        "activated_metric_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semanticId"}, "uniqueItems": true},
        "official_host_aliases": {"$ref": "#/$defs/stringArray"},
        "calendar_id": {"$ref": "#/$defs/semanticId"},
        "calendar_hint": {"$ref": "#/$defs/nonEmpty"},
        "reviewed_calendar_rule": {"$ref": "#/$defs/reviewedCalendarRule"}
        ,"publisher_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}
        ,"activated_semantic_binding_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semanticId"}}
        ,"sector_registry_version": {"$ref": "#/$defs/semanticId"}
      }
    },
    "reviewedLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_key", "relation_type", "from_document_key", "to_document_key", "knowledge_date", "review_state"],
      "properties": {
        "link_key": {"$ref": "#/$defs/nonEmpty"},
        "relation_type": {"enum": ["same-event", "publication-date-support", "event-date-support"]},
        "from_document_key": {"$ref": "#/$defs/nonEmpty"},
        "to_document_key": {"$ref": "#/$defs/nonEmpty"},
        "knowledge_date": {"$ref": "#/$defs/date"},
        "review_state": {"$ref": "#/$defs/reviewState"},
        "event_date": {"$ref": "#/$defs/date"},
        "event_time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "event_timezone": {"$ref": "#/$defs/nonEmpty"},
        "authority_url": {"type": "string", "format": "uri"}
      }
    },
    "reviewIssueSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "rule_id", "business_key", "message", "suggested_action", "promotion_blocking", "evidence_assertion_keys"],
      "properties": {
        "severity": {"enum": ["P0", "P1", "P2"]},
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "business_key": {"$ref": "#/$defs/nonEmpty"},
        "message": {"$ref": "#/$defs/nonEmpty"},
        "suggested_action": {"$ref": "#/$defs/nonEmpty"},
        "promotion_blocking": {"type": "boolean"},
        "evidence_assertion_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}
      }
    },
    "periodSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_key",
        "period_id",
        "fiscal_year",
        "fiscal_quarter",
        "period_type",
        "start_date",
        "end_date",
        "week_count",
        "fiscal_ordinal",
        "is_53_week_year",
        "start_rule_id",
        "evidence_assertion_key",
        "fiscal_claim_assertion_keys",
        "reconciliation_state"
      ],
      "properties": {
        "period_key": {"$ref": "#/$defs/nonEmpty"},
        "period_id": {"$ref": "#/$defs/semanticId"},
        "fiscal_year": {"type": "integer", "minimum": 1900},
        "fiscal_quarter": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
        "period_type": {"enum": ["quarter", "ytd", "annual", "month"]},
        "start_date": {"$ref": "#/$defs/nullableDate"},
        "end_date": {"$ref": "#/$defs/date"},
        "week_count": {"type": ["integer", "null"], "minimum": 1},
        "fiscal_ordinal": {"type": ["integer", "null"]},
        "is_53_week_year": {"type": "boolean"},
        "start_rule_id": {"$ref": "#/$defs/semanticId"},
        "evidence_assertion_key": {"$ref": "#/$defs/nonEmpty"},
        "fiscal_claim_assertion_keys": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "reconciliation_state": {"enum": ["reconciled", "needs_review"]}
      }
    },
    "htmlDatelineLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_kind", "locator_version", "locator_key", "extraction_method_id",
        "text_fingerprint", "match_ordinal", "excerpt_sha256"
      ],
      "properties": {
        "locator_kind": {"const": "html-dateline"},
        "locator_version": {"const": 1},
        "locator_key": {"$ref": "#/$defs/nonEmpty"},
        "extraction_method_id": {"const": "extractor:source:html-dateline@1"},
        "text_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "match_ordinal": {"type": "integer", "minimum": 1},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pdfDatelineLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_kind", "locator_version", "locator_key", "extraction_method_id",
        "page", "text_fingerprint", "match_ordinal", "excerpt_sha256"
      ],
      "properties": {
        "locator_kind": {"const": "pdf-dateline"},
        "locator_version": {"const": 1},
        "locator_key": {"$ref": "#/$defs/nonEmpty"},
        "extraction_method_id": {"const": "extractor:source:pdf-dateline@1"},
        "page": {"type": "integer", "minimum": 1},
        "text_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "match_ordinal": {"type": "integer", "minimum": 1},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "documentDateLocator": {
      "oneOf": [
        {"$ref": "#/$defs/htmlDatelineLocator"},
        {"$ref": "#/$defs/pdfDatelineLocator"}
      ]
    },
    "documentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_key",
        "publisher_id",
        "document_type",
        "source_family",
        "relative_path",
        "expected_sha256",
        "revision",
        "authority_class",
        "publication_date",
        "publication_date_basis",
        "embedded_publication_date",
        "publication_date_locator",
        "report_date",
        "accession",
        "canonical_url",
        "origin_document_key",
        "required",
        "review_state"
      ],
      "properties": {
        "document_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "publisher_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "document_type": {"enum": ["earnings-presentation-workbook", "earnings-release", "business-update", "earnings-transcript", "sec-primary-10-q", "sec-primary-10-k", "sec-primary-8-k", "ceo-letter", "issuer-presentation", "issuer-spreadsheet", "transcript-metadata", "reviewed-model-artifact", "official-page-snapshot"]},
        "source_family": {"enum": ["issuer-spreadsheet", "sec-exhibit", "issuer-pdf", "issuer-transcript", "issuer-html", "sec-primary", "reviewed-page-snapshot", "reviewed-metadata", "reviewed-model"]},
        "relative_path": {"$ref": "#/$defs/nonEmpty"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1},
        "authority_class": {"enum": ["filed-exhibit", "company-release", "company-presentation", "company-transcript", "sec-primary", "reviewed-index", "reviewed-model", "reviewed-official-page"]},
        "publication_date": {"$ref": "#/$defs/date"},
        "publication_date_basis": {"enum": ["sec-filed-date", "embedded-dateline", "reviewed-source-catalog", "reviewed-same-event-link", "review-date", "reviewed-capture"]},
        "embedded_publication_date": {"$ref": "#/$defs/nullableDate"},
        "publication_date_locator": {
          "oneOf": [
            {"$ref": "#/$defs/documentDateLocator"},
            {"type": "null"}
          ]
        },
        "report_date": {"$ref": "#/$defs/nullableDate"},
        "accession": {"type": ["string", "null"], "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "canonical_url": {"type": ["string", "null"], "format": "uri"},
        "origin_document_key": {"type": ["string", "null"]},
        "required": {"type": "boolean"},
        "review_state": {"$ref": "#/$defs/reviewState"},
        "role_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
        "publisher_type": {"type": ["string", "null"], "enum": ["issuer", "sec-registrant", "reviewed-capture", "reviewed-index", "reviewed-research", null]},
        "role_metadata": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "embedded_title": {"$ref": "#/$defs/nonEmpty"},
                "capture_date": {"$ref": "#/$defs/date"},
                "snapshot_producer_id": {"$ref": "#/$defs/nonEmpty"},
                "issuer_content_id": {"$ref": "#/$defs/nonEmpty"},
                "capture_method": {"$ref": "#/$defs/nonEmpty"},
                "transcript_document_key": {"$ref": "#/$defs/nonEmpty"},
                "transcript_sha256": {"$ref": "#/$defs/sha256"},
                "metadata_revision": {"type": "integer", "minimum": 1},
                "metadata_sha256": {"$ref": "#/$defs/sha256"},
                "review_date": {"$ref": "#/$defs/date"},
                "predecessor_metadata_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
                "predecessor_bytes_available": {"enum": ["yes", "no", "not-applicable"]},
                "change_reason": {"$ref": "#/$defs/nonEmpty"},
                "reviewed_link_key": {"type": ["string", "null"]},
                "assertion_authority": {"enum": ["issuer-content", "index-only", "reviewed-model"]},
                "material_quote_locators": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["section", "metadata_key", "start_line", "end_line", "line_digest"],
                    "properties": {
                      "section": {"$ref": "#/$defs/nonEmpty"},
                      "metadata_key": {"$ref": "#/$defs/nonEmpty"},
                      "start_line": {"type": "integer", "minimum": 1},
                      "end_line": {"type": "integer", "minimum": 1},
                      "line_digest": {"$ref": "#/$defs/sha256"}
                    }
                  }
                },
                "reviewed_field_guards": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["section", "metadata_key", "operator", "expected_value"],
                    "properties": {
                      "section": {"$ref": "#/$defs/nonEmpty"},
                      "metadata_key": {"$ref": "#/$defs/nonEmpty"},
                      "operator": {"enum": ["equals", "not-contains"]},
                      "expected_value": {"$ref": "#/$defs/nonEmpty"}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "htmlFiscalLabelClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_key", "claim_kind", "text_fingerprint", "match_ordinal", "excerpt_sha256"
      ],
      "properties": {
        "claim_key": {"$ref": "#/$defs/nonEmpty"},
        "claim_kind": {
          "enum": [
            "fiscal-year", "fiscal-quarter", "annual-period", "fiscal-ytd",
            "trailing-four-quarters"
          ]
        },
        "text_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "match_ordinal": {"type": "integer", "minimum": 1},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "htmlFiscalLabelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_kind", "locator_version", "extraction_method_id", "claims"],
      "properties": {
        "locator_kind": {"const": "html-fiscal-labels"},
        "locator_version": {"const": 1},
        "extraction_method_id": {"const": "extractor:source:html-fiscal-label@1"},
        "claims": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/htmlFiscalLabelClaim"}
        }
      }
    },
    "htmlTableLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_kind", "locator_version", "locator_key", "ordinal", "extraction_method_id",
        "excerpt", "excerpt_sha256", "review_state", "node_path", "table_index", "table_fingerprints",
        "section_fingerprint", "row_header_fingerprint", "column_header_fingerprint", "cell_span_fingerprint", "row_index",
        "row_end_index", "cell_index", "comparison_cell_index", "context_row_index", "exact_position"
      ],
      "properties": {
        "locator_kind": {"const": "html-table"},
        "locator_version": {"const": 1},
        "locator_key": {"$ref": "#/$defs/nonEmpty"},
        "ordinal": {"type": "integer", "minimum": 1},
        "extraction_method_id": {"$ref": "#/$defs/semanticId"},
        "excerpt": {"$ref": "#/$defs/nonEmpty"},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"},
        "review_state": {"$ref": "#/$defs/reviewState"},
        "node_path": {"$ref": "#/$defs/nonEmpty"},
        "table_index": {"type": "integer", "minimum": 0},
        "table_fingerprints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}, "uniqueItems": true},
        "section_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "row_header_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "column_header_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "cell_span_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "row_index": {"type": "integer", "minimum": 0},
        "row_end_index": {"type": ["integer", "null"], "minimum": 0},
        "cell_index": {"type": ["integer", "null"], "minimum": 0},
        "comparison_cell_index": {"type": ["integer", "null"], "minimum": 0},
        "context_row_index": {"type": ["integer", "null"], "minimum": 0},
        "exact_position": {"$ref": "#/$defs/nonEmpty"},
        "fiscal_label_evidence": {
          "oneOf": [
            {"$ref": "#/$defs/htmlFiscalLabelEvidence"},
            {"type": "null"}
          ]
        }
      }
    },
    "htmlTextLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_kind", "locator_version", "locator_key", "ordinal", "extraction_method_id",
        "excerpt", "excerpt_sha256", "review_state", "node_path", "text_fingerprint",
        "ancestor_fingerprints", "match_ordinal"
      ],
      "properties": {
        "locator_kind": {"const": "html-text"},
        "locator_version": {"const": 1},
        "locator_key": {"$ref": "#/$defs/nonEmpty"},
        "ordinal": {"type": "integer", "minimum": 1},
        "extraction_method_id": {"$ref": "#/$defs/semanticId"},
        "excerpt": {"$ref": "#/$defs/nonEmpty"},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"},
        "review_state": {"$ref": "#/$defs/reviewState"},
        "node_path": {"$ref": "#/$defs/nonEmpty"},
        "text_fingerprint": {"$ref": "#/$defs/nonEmpty"},
        "ancestor_fingerprints": {"$ref": "#/$defs/stringArray"},
        "match_ordinal": {"type": "integer", "minimum": 1},
        "value_text_fingerprint": {"type": ["string", "null"], "minLength": 1},
        "comparison_text_fingerprint": {"type": ["string", "null"], "minLength": 1},
        "replacement_header_fingerprint": {"type": ["string", "null"], "minLength": 1},
        "fiscal_label_evidence": {
          "oneOf": [
            {"$ref": "#/$defs/htmlFiscalLabelEvidence"},
            {"type": "null"}
          ]
        }
      }
    },
    "pdfTableLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_kind", "locator_version", "locator_key", "ordinal", "extraction_method_id",
        "excerpt", "excerpt_sha256", "review_state", "page", "region_locator", "table_index",
        "table_fingerprints", "row_header_fingerprint", "column_header_fingerprint", "row_index",
