{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stockmodel/new_ticker_style_plan.schema.json",
  "title": "New Ticker Exact-Cell Style Plan",
  "type": "object",
  "required": [
    "plan_version",
    "status",
    "ticker",
    "module_profile_id",
    "style_contract_digest",
    "binding_plan_digest",
    "action_count",
    "decision_count",
    "actions",
    "decisions"
  ],
  "properties": {
    "plan_version": {"type": "string", "const": "1.0.0"},
    "status": {"const": "PASS"},
    "ticker": {"type": "string", "minLength": 1},
    "module_profile_id": {"type": "string", "minLength": 1},
    "style_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_count": {"type": "integer", "minimum": 0},
    "decision_count": {"type": "integer", "minimum": 0},
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "overlay": {
      "type": "object",
      "required": ["fill"],
      "properties": {
        "fill": {
          "type": "object",
          "required": ["fill_type", "fg_color"],
          "properties": {
            "fill_type": {"const": "solid"},
            "fg_color": {"type": "string", "pattern": "^[0-9A-F]{6}$"}
          },
          "additionalProperties": false
        },
        "font_color": {"type": "string", "pattern": "^[0-9A-F]{6}$"}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "sheet",
        "cell",
        "style_key",
        "policy_id",
        "period",
        "current_value",
        "comparison_period",
        "comparison_value",
        "signal_value",
        "signal_band",
        "overlay",
        "lineage"
      ],
      "properties": {
        "sheet": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$"},
        "style_key": {"type": "string", "minLength": 1},
        "policy_id": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "current_value": {"type": "number"},
        "comparison_period": {"type": ["string", "null"]},
        "comparison_value": {"type": ["number", "null"]},
        "signal_value": {"type": "number"},
        "signal_band": {"type": "string", "minLength": 1},
        "overlay": {"$ref": "#/$defs/overlay"},
        "lineage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "sheet",
        "cell",
        "style_key",
        "policy_id",
        "period",
        "applied",
        "reason"
      ],
      "properties": {
        "sheet": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$"},
        "style_key": {"type": "string", "minLength": 1},
        "policy_id": {"type": "string", "minLength": 1},
        "period": {"type": "string"},
        "applied": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
