  "properties": {
    "package_version": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "stress_test": {
      "type": "boolean"
    },
    "ticker_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ticker"
      ],
      "properties": {
        "ticker": {
          "$ref": "#/$defs/normalizedField"
        },
        "exchange": {
          "$ref": "#/$defs/normalizedField"
        },
        "cik": {
          "$ref": "#/$defs/normalizedField"
        },
        "fiscal_year_end": {
          "$ref": "#/$defs/normalizedField"
        },
        "reporting_currency": {
          "$ref": "#/$defs/normalizedField"
        },
        "investment_case_title": {
          "$ref": "#/$defs/normalizedField"
        },
        "package_version": {
          "$ref": "#/$defs/normalizedField"
        },
        "generated_at_utc": {
          "$ref": "#/$defs/normalizedField"
        }
      }
    },
    "company_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "company_name",
        "business_description",
        "strategic_context",
        "revenue_streams"
      ],
      "properties": {
        "company_name": {
          "$ref": "#/$defs/normalizedField"
        },
        "sector": {
          "$ref": "#/$defs/normalizedField"
        },
        "industry": {
          "$ref": "#/$defs/normalizedField"
        },
        "business_description": {
          "$ref": "#/$defs/normalizedField"
        },
        "strategic_context": {
          "$ref": "#/$defs/normalizedField"
        },
        "revenue_model": {
          "$ref": "#/$defs/normalizedField"
        },
        "revenue_mix_label": {
          "$ref": "#/$defs/normalizedField"
        },
        "revenue_streams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/revenueStreamRow"
          }
        },
        "key_advantages": {
          "$ref": "#/$defs/normalizedField"
        },
        "key_risks": {
          "$ref": "#/$defs/normalizedField"
        },
        "allowed_sector_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quarterly_financials": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/financialRow"
          }
        }
      }
    },
    "calculation_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quarterly_items"],
      "properties": {
        "quarterly_items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/calculationHistoryItem"}
        }
      }
    },
    "annual_financials": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/financialRow"
          }
        },
        "incomplete_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["period", "status", "present_quarters", "missing_quarters", "source_refs", "reason"],
            "properties": {
              "period": {"type": "string", "pattern": "^[0-9]{4}-FY$"},
              "status": {"const": "missing_source"},
              "present_quarters": {"type": "array", "uniqueItems": true, "items": {"enum": ["Q1", "Q2", "Q3", "Q4"]}},
              "missing_quarters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["Q1", "Q2", "Q3", "Q4"]}},
              "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "debt_liquidity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cash",
        "total_debt",
        "net_debt",
        "revolver_availability",
        "liquidity_cash",
        "other_available_liquidity",
        "total_liquidity",
        "liquidity_definition",
        "as_of_date",
        "summary_as_of_date",
        "summary_liquidity_display",
        "summary_liquidity_as_of_display",
        "liquidity_freshness"
      ],
      "properties": {
        "cash": {
          "$ref": "#/$defs/normalizedField"
        },
        "total_debt": {
          "$ref": "#/$defs/normalizedField"
        },
        "net_debt": {
          "$ref": "#/$defs/normalizedField"
        },
        "net_leverage": {
          "$ref": "#/$defs/normalizedField"
        },
        "revolver_availability": {
          "$ref": "#/$defs/normalizedField"
        },
        "liquidity_cash": {
          "$ref": "#/$defs/normalizedField"
        },
        "other_available_liquidity": {
          "$ref": "#/$defs/normalizedField"
        },
        "total_liquidity": {
          "$ref": "#/$defs/normalizedField"
        },
        "liquidity_definition": {
          "$ref": "#/$defs/normalizedField"
        },
        "as_of_date": {
          "$ref": "#/$defs/normalizedField"
        },
        "summary_as_of_date": {
          "$ref": "#/$defs/normalizedField"
        },
        "summary_liquidity_display": {
          "$ref": "#/$defs/normalizedField"
        },
        "summary_liquidity_as_of_display": {
          "$ref": "#/$defs/normalizedField"
        },
        "liquidity_freshness": {
          "type": "object",
          "required": ["disposition", "summary_as_of", "liquidity_as_of", "component_as_of", "mixed_date_components", "reason", "source_ref"],
          "properties": {
            "disposition": {"enum": ["current", "stale_but_displayable_with_date", "blocked_from_current_summary", "incomplete_components"]},
            "summary_as_of": {"type": "string", "minLength": 1},
            "liquidity_as_of": {"type": "string"},
            "component_as_of": {
              "type": "object",
              "properties": {
                "cash": {"type": "string"},
                "revolver": {"type": "string"},
                "other": {"type": "string"}
              },
              "additionalProperties": false
            },
            "mixed_date_components": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1},
            "source_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "liquidity": {
          "$ref": "#/$defs/normalizedField"
        },
        "lease_liabilities": {
          "$ref": "#/$defs/normalizedField"
        },
        "interest_expense": {
          "$ref": "#/$defs/normalizedField"
        },
        "maturity_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "capital_returns": {
      "$ref": "#/$defs/section"
    },
    "normalized_guidance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guidanceItem"
          }
        }
      }
    },
    "segments": {
      "$ref": "#/$defs/segmentsSection"
    },
    "operating_drivers": {
      "$ref": "#/$defs/operatingDriversSection"
    },
    "quarter_notes": {
      "$ref": "#/$defs/quarterNotesSection"
    },
    "investment_case": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "summary",
        "key_debate"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/normalizedField"
        },
        "key_debate": {
          "$ref": "#/$defs/normalizedField"
        },
        "bull_case": {
          "$ref": "#/$defs/normalizedField"
        },
        "base_case": {
          "$ref": "#/$defs/normalizedField"
        },
        "bear_case": {
          "$ref": "#/$defs/normalizedField"
        },
        "scenario_drivers": {
          "$ref": "#/$defs/normalizedField"
        },
        "source_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "valuation_inputs": {
      "$ref": "#/$defs/valuationInputsSection"
    },
    "valuation_outputs": {
      "$ref": "#/$defs/valuationOutputsSection"
    },
    "source_coverage": {
      "$ref": "#/$defs/sourceCoverage"
    },
    "mapping_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mappingGap"
      }
    },
    "manual_review_flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationIssue"
      }
    }
  },
  "$defs": {
    "fieldStatus": {
      "type": "string",
      "enum": [
        "populated",
        "missing_source",
        "missing_mapping",
        "not_applicable",
        "manual_review_required",
        "parser_conflict"
      ]
    },
    "normalizedField": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "value",
        "status",
        "source_ref",
        "core"
      ],
      "properties": {
        "value": {},
        "status": {
          "$ref": "#/$defs/fieldStatus"
        },
        "source_ref": {
          "type": "string"
        },
        "core": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": [
            "$",
            "$m",
            "$bn",
            "USD",
            "USDm",
            "USDbn",
            "%",
            "bps",
            "pp",
            "x",
            "$/share",
            "m shares",
            "shares",
            "count",
            "days",
            "quarters",
            "pts",
            "ratio",
            "stores",
            "visits",
            "m visits",
            "units"
          ]
        },
        "period": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      }
    },
    "calculationHistoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "period_ordinal", "metric", "value", "unit", "source_ref", "status"],
      "properties": {
        "period": {"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"},
        "period_ordinal": {"type": "integer", "minimum": 8000},
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "enum": ["$m", "$/share", "m shares"]},
        "source_ref": {"type": "string", "minLength": 1},
        "status": {"const": "populated"},
        "definition": {"type": "string"}
      }
    },
    "revenueStreamRow": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "member",
        "mix",
        "unit",
        "period",
        "source_ref",
        "display_order"
      ],
      "properties": {
        "member": {
          "$ref": "#/$defs/normalizedField"
        },
        "mix": {
          "$ref": "#/$defs/normalizedField"
        },
        "unit": {
          "type": "string",
          "enum": ["%", "ratio", "$m", "USDm"]
        },
        "period": {
          "type": "string",
          "minLength": 4
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "display_order": {
          "type": "integer"
        }
      }
    },
    "financialRow": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "period",
        "fiscal_year",
        "revenue"
      ],
      "properties": {
        "period": {
          "type": "string"
        },
        "fiscal_year": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "fiscal_quarter": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "revenue": {
          "$ref": "#/$defs/normalizedField"
        },
        "cost_of_goods_sold": {"$ref": "#/$defs/normalizedField"},
        "gross_profit": {
          "$ref": "#/$defs/normalizedField"
        },
        "operating_income": {
          "$ref": "#/$defs/normalizedField"
        },
        "base_ebitda": {
          "$ref": "#/$defs/normalizedField"
        },
        "adjusted_ebitda": {
          "$ref": "#/$defs/normalizedField"
        },
        "net_income": {
