{
  "$schema": "https://local.stockmodel/sheet_data_flow_map.schema.json",
  "version": "0.1.0",
  "purpose": "Read-only data lineage and sheet architecture map for the future value-only new-ticker filler runtime.",
  "standard_visible_sheets": [
    "SUMMARY",
    "Valuation",
    "BS_Segments",
    "Operating_Drivers",
    "{ticker}_Investment_Case",
    "Quarter_Notes_UI",
    "Promise_Progress_UI",
    "QA_Log",
    "Needs_Review",
    "QA_Checks"
  ],
  "runtime_rule": "Future filler writes validated normalized values only into shell writable zones; it must not parse sources, mutate layout, or patch rendered content.",
  "support_sheet_dependencies": [
    {
      "name": "History_Q",
      "storage_type": "workbook_support_sheet",
      "role": "Quarterly financial history and derived facts.",
      "feeds_visible_sheets": ["SUMMARY", "Valuation", "BS_Segments", "Operating_Drivers", "{ticker}_Investment_Case"],
      "future_role": "Audit/output support; normalized package should be runtime input."
    },
    {
      "name": "DATA_Facts_Long",
      "storage_type": "workbook_support_sheet",
      "role": "Long-form SEC/XBRL fact table.",
      "feeds_visible_sheets": ["BS_Segments", "QA_Checks"],
      "future_role": "Source coverage and audit support."
    },
    {
      "name": "SEC_Audit_Log",
      "storage_type": "workbook_support_sheet",
      "role": "SEC tag/source/filing audit rows.",
      "feeds_visible_sheets": ["SUMMARY", "QA_Log", "QA_Checks"],
      "future_role": "Source refs and audit support."
    },
    {
      "name": "Guidance_Normalized",
      "storage_type": "workbook_support_sheet",
      "role": "Current guidance support/readback sheet.",
      "feeds_visible_sheets": ["Promise_Progress_UI", "Valuation", "{ticker}_Investment_Case", "Quarter_Notes_UI"],
      "future_role": "Input to normalized guidance builder, not filler runtime source."
    },
    {
      "name": "Guidance_Raw",
      "storage_type": "workbook_support_sheet",
      "role": "Raw guidance extraction output.",
      "feeds_visible_sheets": ["Promise_Progress_UI", "QA_Checks"],
      "future_role": "Audit-only source; must not bind directly."
    },
    {
      "name": "Slides_Guidance",
      "storage_type": "workbook_support_sheet",
      "role": "Guidance extracted from presentations and releases.",
      "feeds_visible_sheets": ["Promise_Progress_UI", "Valuation", "{ticker}_Investment_Case"],
      "future_role": "Input to normalized guidance builder."
    },
    {
      "name": "Quarter_Notes",
      "storage_type": "workbook_support_sheet",
      "role": "Quarter-note candidates.",
      "feeds_visible_sheets": ["Quarter_Notes_UI", "{ticker}_Investment_Case"],
      "future_role": "Input to normalized quarter-notes builder."
    },
    {
      "name": "Quarter_Notes_Evidence",
      "storage_type": "workbook_support_sheet",
      "role": "Evidence rows behind quarter notes.",
      "feeds_visible_sheets": ["Quarter_Notes_UI", "QA_Log"],
      "future_role": "Source refs and audit support."
    },
    {
      "name": "Quarter_Narrative_Data",
      "storage_type": "workbook_support_sheet",
      "role": "Selected quarter narrative rows and audit data.",
      "feeds_visible_sheets": ["Quarter_Notes_UI"],
      "future_role": "Audit support for normalized quarter notes."
    },
    {
      "name": "Promise_Progress",
      "storage_type": "workbook_support_sheet",
      "role": "Promise/guidance lifecycle rows.",
      "feeds_visible_sheets": ["Promise_Progress_UI", "{ticker}_Investment_Case"],
      "future_role": "Input to normalized guidance lifecycle builder."
    },
    {
      "name": "Promise_Evidence",
      "storage_type": "workbook_support_sheet",
      "role": "Evidence backing promise rows.",
      "feeds_visible_sheets": ["Promise_Progress_UI", "QA_Log"],
      "future_role": "Source refs and audit support."
    },
    {
      "name": "Slides_Segments",
      "storage_type": "workbook_support_sheet",
      "role": "Segment taxonomy and values from IR files.",
      "feeds_visible_sheets": ["BS_Segments", "Operating_Drivers", "{ticker}_Investment_Case"],
      "future_role": "Input to normalized segment builder."
    },
    {
      "name": "operating_drivers_raw",
      "storage_type": "workbook_support_sheet",
      "role": "Operating driver rows/source snippets.",
      "feeds_visible_sheets": ["Operating_Drivers", "QA_Checks"],
      "future_role": "Audit support for normalized operating drivers."
    },
    {
      "name": "Debt_Tranches_Q",
      "storage_type": "workbook_support_sheet",
      "role": "Debt tranche support by quarter.",
      "feeds_visible_sheets": ["Valuation", "BS_Segments", "SUMMARY"],
      "future_role": "Input to normalized debt/liquidity builder."
    },
    {
      "name": "Hidden_Value_Flags",
      "storage_type": "workbook_support_sheet",
      "role": "Hidden value scoring/readback support.",
      "feeds_visible_sheets": ["Valuation"],
      "future_role": "Shell/readback support only."
    },
    {
      "name": "QA_Log",
      "storage_type": "visible_qa_sheet",
      "role": "Validation and review audit output.",
      "feeds_visible_sheets": [],
      "future_role": "Output-only from validator/readback checks."
    },
    {
      "name": "Needs_Review",
      "storage_type": "visible_qa_sheet",
      "role": "Curated manual review output.",
      "feeds_visible_sheets": [],
      "future_role": "Output-only from manual_review_flags."
    },
    {
      "name": "QA_Checks",
      "storage_type": "visible_qa_sheet",
      "role": "Binding/quality check output.",
      "feeds_visible_sheets": [],
      "future_role": "Output-only from mapping_gaps and readback checks."
    }
  ],
  "cross_sheet_dependencies": [
    {
      "from": "History_Q",
      "to": "Valuation",
      "data": "actual quarterly financial series, share count, cash flow, debt and cash",
      "calculation_type": "source-derived values plus Excel-formula-derived presentation",
      "future_normalization_point": "quarterly_financials, debt_liquidity, capital_returns"
    },
    {
      "from": "History_Q",
      "to": "SUMMARY",
      "data": "latest and trend financial facts",
      "calculation_type": "source-derived and derived summary metrics",
      "future_normalization_point": "quarterly_financials, debt_liquidity"
    },
    {
      "from": "Guidance_Normalized",
      "to": "Promise_Progress_UI",
      "data": "metric, value/range, horizon, stated-in period, source context",
      "calculation_type": "source-derived classification",
      "future_normalization_point": "normalized_guidance.items"
    },
    {
      "from": "Guidance_Normalized",
      "to": "Valuation",
      "data": "guidance panels and trend flags",
      "calculation_type": "source-derived guidance plus formula-derived display",
      "future_normalization_point": "normalized_guidance.items"
    },
    {
      "from": "Quarter_Notes_Evidence",
      "to": "Quarter_Notes_UI",
      "data": "evidence-backed quarter notes and model implications",
      "calculation_type": "source-derived text selection",
      "future_normalization_point": "quarter_notes.items"
    },
    {
      "from": "Slides_Segments",
      "to": "BS_Segments",
      "data": "quarterly and annual segment rows",
      "calculation_type": "source-derived segment taxonomy and values",
      "future_normalization_point": "segments.items"
    },
    {
      "from": "BS_Segments",
      "to": "Operating_Drivers",
      "data": "segment support values and consistency checks",
      "calculation_type": "source-derived visible duplication",
      "future_normalization_point": "segments.items and operating_drivers.items"
    },
    {
      "from": "Operating_Drivers",
      "to": "{ticker}_Investment_Case",
      "data": "driver reads and scenario hooks",
      "calculation_type": "source-derived text/table rows",
      "future_normalization_point": "operating_drivers.items and investment_case.scenario_drivers"
    },
    {
      "from": "Valuation",
      "to": "{ticker}_Investment_Case",
      "data": "valuation hooks and formula-derived scenario outputs",
      "calculation_type": "Excel-formula-derived presentation from source-derived inputs",
      "future_normalization_point": "investment_case.valuation_hooks and shell formulas"
    },
    {
      "from": "normalized_company_data_validation",
      "to": "QA_Log",
      "data": "structured validation issues",
      "calculation_type": "pre-render validation output",
      "future_normalization_point": "manual_review_flags"
    },
    {
      "from": "workbook_binding_map",
      "to": "QA_Checks",
      "data": "binding gaps and required field coverage",
      "calculation_type": "pre-render mapping validation output",
      "future_normalization_point": "mapping_gaps"
    }
  ],
  "sheets": [
    {
      "sheet": "SUMMARY",
      "source_inputs": {
        "sec_xbrl": ["History_Q", "SEC_Audit_Log", "DATA_Facts_Long"],
        "ir_files": ["company overview source material when profile/doc-intel provides it"],
        "transcripts": ["strategic context when parsed into overview evidence"],
        "presentations": ["revenue streams and operating model when parsed"],
        "manual_profile_data": ["company_overview", "company_profiles.py"],
        "derived_calculated_fields": ["latest quarter metrics", "YoY/TTM summary metrics", "leverage/liquidity summary"]
      },
      "storage_layer": {
        "raw_source_cache": ["StockModelData/sec_cache/{ticker}", "StockModelData/tickers/{ticker}"],
        "parsed_data": ["summary_df", "History_Q", "Leverage_Liquidity", "SEC_Audit_Log"],
        "normalized_fields_should_live": ["company_profile", "quarterly_financials", "debt_liquidity", "source_coverage"],
        "support_sheets_currently_store_intermediate_data": ["History_Q", "SEC_Audit_Log", "Leverage_Liquidity"],
        "visible_ui_vs_audit_only": {
          "visible_ui": ["SUMMARY"],
          "audit_only": ["SEC_Audit_Log", "DATA_Facts_Long"]
        }
      },
      "transformation_logic": {
        "parser_normalizer_module_paths": ["pbi_xbrl/excel_writer_summary_builder.py", "pbi_xbrl/summary_overview.py", "pbi_xbrl/excel_writer_core.py"],
        "data_selection_rules": ["select latest source-ranked financials", "use company overview/profile rows for descriptive sections", "attach source notes/comments"],
        "ticker_specific_branches": ["profile-specific overview text and sector terminology"],
        "source_backed_vs_profile_backed_vs_inferred": "Financial facts are source-backed or derived from source-backed facts; narrative overview can be profile-backed only where binding policy allows it.",
        "missing_source_behavior": "Current writer may render N/A/generic fallback; future filler must leave values blank and emit mapping gaps/manual review flags."
      },
      "workbook_presentation": [
        {
          "visible_sheet_section": "Company Overview",
          "binding_ids": ["summary_company_description", "summary_strategic_context", "summary_revenue_stream_rows", "summary_key_advantage"],
          "normalized_fields": ["company_profile.business_description", "company_profile.strategic_context", "company_profile.revenue_streams", "company_profile.key_advantages"],
          "target_or_anchor": "Company Overview / B4:F16",
          "missing_display": "blank mapped value plus Needs_Review or mapping gap",
          "must_never_show": ["raw cache paths", "unsupported sector terms", "generic copied text as source fact"]
        },
        {
          "visible_sheet_section": "Key Financials",
          "binding_ids": ["summary_as_of_quarter", "summary_quarterly_operating_income"],
          "normalized_fields": ["quarterly_financials.rows.0.period", "quarterly_financials.rows.0.operating_income"],
          "target_or_anchor": "Key Financials / B30:F38",
          "missing_display": "blank values and mapping gap",
          "must_never_show": ["raw SEC tags as prose", "parser snippets"]
        },
        {
          "visible_sheet_section": "Leverage/Liquidity",
          "binding_ids": ["summary_net_leverage", "summary_liquidity"],
          "normalized_fields": ["debt_liquidity.net_leverage", "debt_liquidity.total_liquidity"],
          "target_or_anchor": "Leverage / Liquidity / B40:F47",
          "missing_display": "blank values and mapping gap",
          "must_never_show": ["invented liquidity facts"]
        }
      ],
      "validation_and_qa": {
        "pre_render_validation_rules": ["unexplained_empty_core_field", "unsupported_sector_specific_leakage"],
        "workbook_validation_rules": ["bad marker scan", "cross-company leakage scan", "required sheet scan"],
        "manual_review_flag": "required when profile-backed narrative is missing or unsupported",
        "mapping_gap_behavior": "required financial/debt fields create mapping_gaps before render"
      },
      "ownership": {
        "current_code_owner_modules": ["pbi_xbrl/excel_writer_summary_builder.py", "pbi_xbrl/excel_writer_summary_sheet.py", "pbi_xbrl/summary_overview.py"],
        "future_intended_owner_modules": ["future normalized_company_data_builder", "docs/workbook_binding_map.json", "future value-only filler"],
        "current_implementation_recommendation": "refactor data selection out of writer; keep source-ranking concepts"
      }
    },
    {
      "sheet": "Valuation",
      "source_inputs": {
        "sec_xbrl": ["History_Q", "DATA_Facts_Long", "SEC_Audit_Log"],
        "ir_files": ["guidance/debt/capital-return support files"],
        "transcripts": ["guidance and management commentary when parsed"],
        "presentations": ["Slides_Guidance", "Slides_Debt_Profile"],
        "manual_profile_data": ["company_profile", "ticker flags"],
        "derived_calculated_fields": ["historical formula outputs", "hidden value state", "Capital Return", "canonical Investment Case summary references"]
      },
      "storage_layer": {
        "raw_source_cache": ["StockModelData/sec_cache/{ticker}", "StockModelData/tickers/{ticker}", "StockModelData/market_cache"],
        "parsed_data": ["History_Q", "Debt_Tranches_Q", "Leverage_Liquidity", "{ticker}_Investment_Case_Data", "Hidden_Value_Flags"],
        "normalized_fields_should_live": ["quarterly_financials", "annual_financials", "debt_liquidity", "capital_returns", "normalized_guidance"],
        "support_sheets_currently_store_intermediate_data": ["History_Q", "Debt_Tranches_Q", "Debt_Profile", "Hidden_Value_Base", "Hidden_Value_Flags"],
        "visible_ui_vs_audit_only": {
          "visible_ui": ["Valuation"],
          "audit_only": ["{ticker}_Investment_Case_Data", "Hidden_Value_Audit", "Debt_Tranches_Q"]
        }
      },
      "transformation_logic": {
        "parser_normalizer_module_paths": ["pbi_xbrl/excel_writer_core.py", "pbi_xbrl/excel_writer_valuation_orchestrator.py", "pbi_xbrl/valuation.py", "pbi_xbrl/valuation_precompute_runtime.py"],
        "data_selection_rules": ["derive valuation source views", "select latest 12 quarters", "precompute debt/capital-return/guidance support", "render formulas and support panels"],
        "ticker_specific_branches": ["ANF side panel/fiscal behavior", "PBI/GPRE guidance source contract labels", "GPRE warrant overlays", "sector hidden-value flags"],
        "source_backed_vs_profile_backed_vs_inferred": "Core actuals/debt/capital returns must be source-backed or derived from source-backed rows; valuation formulas are shell-owned.",
        "missing_source_behavior": "Current output can show blanks/NM and later QA; future filler must emit valuation mapping gaps before render."
      },
      "workbook_presentation": [
        {
          "visible_sheet_section": "Actuals and operating metrics",
          "binding_ids": ["valuation_revenue_series", "valuation_operating_income_series", "valuation_ebitda_series", "valuation_fcf_series"],
          "normalized_fields": ["quarterly_financials.rows.0.revenue", "quarterly_financials.rows.0.operating_income", "quarterly_financials.rows.0.adjusted_ebitda", "quarterly_financials.rows.0.free_cash_flow"],
          "target_or_anchor": "Actuals / B20:M80",
          "missing_display": "blank value cells; formulas/static labels remain intact",
          "must_never_show": ["parser snippets", "raw source text", "wrong metric guidance"]
        },
        {
          "visible_sheet_section": "Share count",
          "binding_ids": ["valuation_diluted_shares_series"],
          "normalized_fields": ["quarterly_financials.rows.0.diluted_shares"],
          "target_or_anchor": "Diluted shares (m) / B81:M90",
          "missing_display": "blank and mapping gap",
          "must_never_show": ["share count unit outliers"]
        },
        {
          "visible_sheet_section": "Leverage and liquidity / Capital return",
          "binding_ids": ["valuation_total_debt_series", "valuation_cash_series", "valuation_buybacks_series"],
          "normalized_fields": ["debt_liquidity.total_debt", "debt_liquidity.cash", "capital_returns.buybacks"],
          "target_or_anchor": "Leverage & Liquidity and Capital return / B120:M170",
          "missing_display": "blank required values plus mapping gaps; optional capital returns can be not_applicable",
          "must_never_show": ["invented debt or buyback facts"]
        }
      ],
      "validation_and_qa": {
        "pre_render_validation_rules": ["valuation_core_mapping_gap", "share_count_outlier", "guidance_metric_misclassification", "parser_noise_snippet"],
        "workbook_validation_rules": ["formula/error token scan", "bad marker scan", "hidden value sync", "Needs_Review P1"],
        "manual_review_flag": "required for optional valuation proxies and non-source-backed guidance",
        "mapping_gap_behavior": "required valuation bindings block promotion"
      },
      "ownership": {
        "current_code_owner_modules": ["pbi_xbrl/excel_writer_valuation_orchestrator.py", "pbi_xbrl/excel_writer_valuation_*", "pbi_xbrl/valuation.py"],
        "future_intended_owner_modules": ["frozen template shell", "docs/workbook_binding_map.json", "future value-only filler"],
        "current_implementation_recommendation": "keep formulas/layout as shell knowledge; refactor source selection into normalized package"
      }
    },
    {
      "sheet": "BS_Segments",
      "source_inputs": {
        "sec_xbrl": ["History_Q", "DATA_Facts_Long", "local balance-sheet details"],
        "ir_files": ["Slides_Segments", "financial statement files"],
        "transcripts": [],
        "presentations": ["segment slides"],
        "manual_profile_data": ["segment labels", "sector policies"],
        "derived_calculated_fields": ["segment totals", "carry-forward low-change series"]
      },
      "storage_layer": {
        "raw_source_cache": ["StockModelData/sec_cache/{ticker}", "StockModelData/tickers/{ticker}"],
        "parsed_data": ["History_Q", "Slides_Segments", "DATA_Facts_Long"],
        "normalized_fields_should_live": ["debt_liquidity", "segments"],
        "support_sheets_currently_store_intermediate_data": ["Slides_Segments", "DATA_Facts_Long", "History_Q"],
        "visible_ui_vs_audit_only": {
          "visible_ui": ["BS_Segments"],
          "audit_only": ["Slides_Segments", "DATA_Facts_Long"]
        }
      },
      "transformation_logic": {
        "parser_normalizer_module_paths": ["pbi_xbrl/excel_writer_bs_segments.py", "pbi_xbrl/excel_writer_segments.py", "pbi_xbrl/excel_writer_segment_sources.py"],
        "data_selection_rules": ["select balance-sheet rows", "parse quarterly/annual segment rows", "apply segment source policies"],
        "ticker_specific_branches": ["GPRE carbon equipment policy", "ANF fiscal/brand handling", "PBI segment repair helpers"],
        "source_backed_vs_profile_backed_vs_inferred": "Segment values must be source-backed; profile can only provide allowed labels/taxonomy hints.",
        "missing_source_behavior": "Current writer may omit/blank rows; future filler emits mapping gaps and omits unsupported rows."
      },
      "workbook_presentation": [
        {
          "visible_sheet_section": "Balance sheet",
          "binding_ids": ["bs_cash_series", "bs_debt_series"],
          "normalized_fields": ["debt_liquidity.cash", "debt_liquidity.total_debt"],
          "target_or_anchor": "Liquidity / Assets / B8:I45",
          "missing_display": "blank values and mapping gaps",
          "must_never_show": ["invented balance-sheet facts"]
        },
        {
          "visible_sheet_section": "Quarterly and annual segments",
          "binding_ids": ["bs_segment_quarterly_rows", "bs_segment_annual_rows"],
          "normalized_fields": ["segments.items.0.revenue", "segments.items.0.annual_revenue"],
          "target_or_anchor": "Quarterly segments and Annual segments / B50:I120",
          "missing_display": "no segment row until taxonomy/value exists",
          "must_never_show": ["unsupported sector-specific segment rows"]
        }
      ],
      "validation_and_qa": {
        "pre_render_validation_rules": ["unsupported_sector_specific_leakage", "unexplained_empty_core_field"],
        "workbook_validation_rules": ["BS_Segments source-backed hydration", "segment cross-sheet checks"],
        "manual_review_flag": "required when segment taxonomy is missing or source conflicts",
        "mapping_gap_behavior": "segment gaps are optional/manual-review unless promotion requires segment detail"
      },
      "ownership": {
        "current_code_owner_modules": ["pbi_xbrl/excel_writer_bs_segments.py", "pbi_xbrl/excel_writer_segment_sources.py"],
        "future_intended_owner_modules": ["future segments normalizer", "docs/workbook_binding_map.json"],
        "current_implementation_recommendation": "refactor segment row selection; avoid ticker-specific sheet repairs as runtime behavior"
      }
    },
    {
      "sheet": "Operating_Drivers",
      "source_inputs": {
        "sec_xbrl": ["10-Q/10-K filing text", "History_Q"],
        "ir_files": ["earnings releases", "financial statements", "source directories"],
        "transcripts": ["operating commentary"],
        "presentations": ["earnings presentations and slides text"],
        "manual_profile_data": ["driver templates", "priority terms", "sector intro tables"],
        "derived_calculated_fields": ["driver history rows", "segment support values", "derivative OCI bridge"]
      },
      "storage_layer": {
        "raw_source_cache": ["StockModelData/sec_cache/{ticker}", "StockModelData/tickers/{ticker}", "writer cache"],
        "parsed_data": ["operating_driver_history_rows", "operating_drivers_raw", "Quarter_Notes", "Promise_Progress", "Slides_Segments"],
        "normalized_fields_should_live": ["operating_drivers", "segments", "quarter_notes"],
        "support_sheets_currently_store_intermediate_data": ["operating_drivers_raw", "Slides_Segments", "Quarter_Notes"],
        "visible_ui_vs_audit_only": {
          "visible_ui": ["Operating_Drivers"],
          "audit_only": ["operating_drivers_raw"]
        }
      },
      "transformation_logic": {
        "parser_normalizer_module_paths": ["pbi_xbrl/excel_writer_drivers.py", "pbi_xbrl/operating_drivers_runtime.py", "pbi_xbrl/excel_writer_operating_drivers.py"],
        "data_selection_rules": ["load source records by quarter", "rank source lines", "apply driver templates", "build current outlook/watchlist/actuals"],
        "ticker_specific_branches": ["ANF retail/fiscal cleanup", "GPRE commercial/economics drivers", "profile-specific templates"],
        "source_backed_vs_profile_backed_vs_inferred": "Profile templates can define expected rows; visible values/current reads must be source-backed or manual-review.",
        "missing_source_behavior": "Current fallback can be profile/template-driven; future filler emits manual review and leaves section blank."
      },
      "workbook_presentation": [
        {
          "visible_sheet_section": "Current watchlist",
          "binding_ids": ["od_watchlist_rows"],
          "normalized_fields": ["operating_drivers.items.0.current_read"],
          "target_or_anchor": "Current watchlist / B7:N30",
          "missing_display": "blank row family and manual review",
          "must_never_show": ["sector fallback facts", "unsupported terminology"]
        },
        {
          "visible_sheet_section": "Current/latest outlook and actuals",
          "binding_ids": ["od_current_outlook_rows", "od_driver_actuals_rows"],
          "normalized_fields": ["operating_drivers.items.0.driver", "operating_drivers.items.0.metric_value"],
          "target_or_anchor": "Current/latest outlook and Actuals / B31:N125",
          "missing_display": "omit value rows until source-backed",
          "must_never_show": ["parser noise snippets", "raw source paths"]
        }
      ],
      "validation_and_qa": {
        "pre_render_validation_rules": ["parser_noise_snippet", "unsupported_sector_specific_leakage"],
        "workbook_validation_rules": ["Operating_Drivers direct BS_Segments segment mapping", "bad marker scan"],
        "manual_review_flag": "required for missing source-backed driver families",
        "mapping_gap_behavior": "required watchlist/outlook gaps block promotion"
      },
      "ownership": {
        "current_code_owner_modules": ["pbi_xbrl/excel_writer_drivers.py", "pbi_xbrl/operating_drivers_runtime.py", "pbi_xbrl/excel_writer_operating_drivers.py"],
        "future_intended_owner_modules": ["future operating_drivers normalizer", "normalized_company_data_validation.py"],
        "current_implementation_recommendation": "keep source ranking; refactor visible row assembly and avoid profile fallback facts"
      }
    },
    {
      "sheet": "{ticker}_Investment_Case",
      "source_inputs": {
