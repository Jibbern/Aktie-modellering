{
  "$schema": "https://local.stockmodel/standard_template_shell_manifest.schema.json",
  "version": "0.1.0",
  "file_type": ".xlsx",
  "description": "Manifest for the materialized frozen standard stock-model workbook shell. The shell file exists at templates/standard_stock_model_template.xlsx and future runtime may write values only to declared writable zones.",
  "visible_sheet_order": [
    "SUMMARY",
    "Valuation",
    "BS_Segments",
    "Operating_Drivers",
    "{ticker}_Investment_Case",
    "Quarter_Notes_UI",
    "Promise_Progress_UI",
    "QA_Log",
    "Needs_Review",
    "QA_Checks"
  ],
  "ticker_sheet_token_rule": {
    "template": "{ticker}_Investment_Case",
    "token": "{ticker}",
    "example": "PBI_Investment_Case",
    "rule": "Replace {ticker} with the uppercase ticker only for the resolved workbook sheet name; bindings and manifest keep the tokenized name."
  },
  "static_layout_ownership": {
    "owner": "frozen_template_shell",
    "owns": [
      "visible sheet order",
      "sheet names and tokenized investment-case sheet",
      "static labels",
      "formulas",
      "merged cells",
      "styles",
      "row heights",
      "column widths",
      "freeze panes",
      "print and view settings",
      "hidden/static support formulas"
    ],
    "future_filler_rule": "Values only; no layout mutation."
  },
  "required_anchors": [
    {
      "anchor_id": "summary_company_overview_anchor",
      "sheet": "SUMMARY",
      "zone_id": "summary_company_description_value",
      "anchor_label": "What the company does",
      "binding_required": true
    },
    {
      "anchor_id": "summary_key_financials_anchor",
      "sheet": "SUMMARY",
      "zone_id": "summary_key_financials_values",
      "anchor_label": "Key Financials",
      "binding_required": true
    },
    {
      "anchor_id": "summary_leverage_liquidity_anchor",
      "sheet": "SUMMARY",
      "zone_id": "summary_leverage_liquidity_values",
      "anchor_label": "Leverage / Liquidity",
      "binding_required": true
    },
    {
      "anchor_id": "valuation_actuals_anchor",
      "sheet": "Valuation",
      "zone_id": "valuation_actuals_quarterly_values",
      "anchor_label": "Actuals",
      "binding_required": true
    },
    {
      "anchor_id": "valuation_share_count_anchor",
      "sheet": "Valuation",
      "zone_id": "valuation_share_count_values",
      "anchor_label": "Diluted shares (m)",
      "binding_required": true
    },
    {
      "anchor_id": "valuation_debt_anchor",
      "sheet": "Valuation",
      "zone_id": "valuation_debt_liquidity_values",
      "anchor_label": "Leverage & Liquidity",
      "binding_required": true
    },
    {
      "anchor_id": "bs_liquidity_anchor",
      "sheet": "BS_Segments",
      "zone_id": "bs_liquidity_values",
      "anchor_label": "Liquidity / Assets",
      "binding_required": true
    },
    {
      "anchor_id": "operating_drivers_watchlist_anchor",
      "sheet": "Operating_Drivers",
      "zone_id": "od_watchlist_values",
      "anchor_label": "Current watchlist",
      "binding_required": true
    },
    {
      "anchor_id": "investment_snapshot_anchor",
