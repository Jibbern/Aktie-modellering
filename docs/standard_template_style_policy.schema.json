{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stockmodel/standard_template_style_policy.schema.json",
  "title": "Standard Template Style Policy Contract",
  "type": "object",
  "required": [
    "version",
    "style_plan_contract_version",
    "description",
    "palette_tokens",
    "threshold_sets",
    "policies",
    "state_policies",
    "style_disabled"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "version": {"type": "string", "const": "1.2.0"},
    "style_plan_contract_version": {"type": "string", "const": "1.0.0"},
    "description": {"type": "string", "minLength": 1},
    "palette_tokens": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"$ref": "#/$defs/styleOverlay"}
    },
    "threshold_sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/thresholdSet"}
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/policy"}
    },
    "state_policies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/statePolicy"}
    },
    "style_disabled": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/styleDisabled"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "styleOverlay": {
      "type": "object",
      "required": ["fill"],
      "properties": {
        "fill": {
          "type": "object",
          "required": ["fill_type", "fg_color"],
          "properties": {
            "fill_type": {"const": "solid"},
            "fg_color": {"type": "string", "pattern": "^[0-9A-F]{6}$"}
          },
          "additionalProperties": false
        },
        "font_color": {"type": "string", "pattern": "^[0-9A-F]{6}$"}
      },
      "additionalProperties": false
    },
    "thresholdBand": {
      "type": "object",
      "required": ["band_id", "overlay_token"],
      "properties": {
        "band_id": {"$ref": "#/$defs/id"},
        "overlay_token": {"$ref": "#/$defs/id"},
        "minimum": {"type": "number"},
        "minimum_inclusive": {"type": "boolean"},
        "maximum": {"type": "number"},
        "maximum_inclusive": {"type": "boolean"}
      },
      "anyOf": [
        {"required": ["minimum", "minimum_inclusive"]},
        {"required": ["maximum", "maximum_inclusive"]}
      ],
      "additionalProperties": false
    },
    "thresholdSet": {
      "type": "object",
      "required": ["threshold_set_id", "bands"],
      "properties": {
        "threshold_set_id": {"$ref": "#/$defs/id"},
        "bands": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/thresholdBand"}
        }
      },
      "additionalProperties": false
    },
    "targetSelector": {
      "type": "object",
      "required": ["selector_type", "target_id", "metric_id"],
      "properties": {
        "selector_type": {"enum": ["binding", "formula"]},
        "target_id": {"$ref": "#/$defs/id"},
        "metric_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "stateTargetSelector": {
      "type": "object",
      "required": ["selector_type", "target_id", "state_field", "period_field", "target_fields"],
      "properties": {
        "selector_type": {"const": "binding_state"},
        "target_id": {"$ref": "#/$defs/id"},
        "state_field": {"$ref": "#/$defs/id"},
        "period_field": {"$ref": "#/$defs/id"},
        "target_fields": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    },
    "statePolicy": {
      "type": "object",
      "required": [
        "policy_id",
        "owner_module_id",
        "owned_style_ids",
        "state_overlays",
        "no_style_states",
        "target_selectors"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/id"},
        "owner_module_id": {"$ref": "#/$defs/id"},
        "owned_style_ids": {"$ref": "#/$defs/stringList"},
        "state_overlays": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "triggered": {"$ref": "#/$defs/id"},
            "near_miss": {"$ref": "#/$defs/id"},
            "invalid_input": {"$ref": "#/$defs/id"},
            "unavailable": {"$ref": "#/$defs/id"},
            "insufficient_evidence": {"$ref": "#/$defs/id"},
            "manual_review_required": {"$ref": "#/$defs/id"},
            "conflict": {"$ref": "#/$defs/id"},
            "current_primary / manual_review_required": {"$ref": "#/$defs/id"},
            "current_secondary / manual_review_required": {"$ref": "#/$defs/id"},
            "history / manual_review_required": {"$ref": "#/$defs/id"},
            "current_primary / conflict": {"$ref": "#/$defs/id"},
            "current_secondary / conflict": {"$ref": "#/$defs/id"},
            "history / conflict": {"$ref": "#/$defs/id"},
            "current_primary / unavailable": {"$ref": "#/$defs/id"},
            "current_secondary / unavailable": {"$ref": "#/$defs/id"},
            "history / unavailable": {"$ref": "#/$defs/id"}
          },
          "additionalProperties": false
        },
        "no_style_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "triggered",
              "near_miss",
              "not_triggered",
              "invalid_input",
              "unavailable",
              "insufficient_evidence",
              "accepted",
              "current_primary / accepted",
              "current_secondary / accepted",
              "history / accepted"
            ]
          }
        },
        "target_selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stateTargetSelector"}
        }
      },
      "additionalProperties": false
    },
    "styleDisabled": {
      "type": "object",
      "required": [
        "formula_id",
        "sheet",
        "target",
        "owner_module_id",
        "economic_reason",
        "expected_empty_behavior"
      ],
      "properties": {
        "formula_id": {"$ref": "#/$defs/id"},
        "sheet": {"type": "string", "minLength": 1},
        "target": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(?::[A-Z]{1,3}[1-9][0-9]*)?$"
        },
        "owner_module_id": {"$ref": "#/$defs/id"},
        "economic_reason": {"type": "string", "minLength": 12},
        "expected_empty_behavior": {"const": "no_style"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "policy_id",
        "owner_module_id",
        "owned_style_ids",
        "metric_family",
        "period_type",
        "period_axis_id",
        "comparison_basis",
        "comparison_lag",
        "polarity",
        "threshold_set_id",
        "accepted_units",
        "applies_to",
        "missing_value_behavior",
        "comparator_missing_behavior",
        "status_exclusions",
        "target_selectors"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/id"},
        "owner_module_id": {"$ref": "#/$defs/id"},
        "owned_style_ids": {"$ref": "#/$defs/stringList"},
        "metric_family": {"$ref": "#/$defs/id"},
        "period_type": {"enum": ["quarter", "fiscal_year"]},
        "period_axis_id": {"$ref": "#/$defs/id"},
        "comparison_basis": {
          "enum": [
            "prior_quarter",
            "prior_year_quarter",
            "prior_ttm",
            "prior_fiscal_year",
            "direct_value",
            "disabled"
          ]
        },
        "comparison_lag": {"type": "integer", "minimum": 0, "maximum": 4},
        "polarity": {
          "enum": ["higher_is_better", "lower_is_better", "neutral_change", "disabled"]
        },
        "threshold_set_id": {"$ref": "#/$defs/id"},
        "accepted_units": {"$ref": "#/$defs/stringList"},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["raw", "formula"]}
        },
        "missing_value_behavior": {"const": "no_style"},
        "comparator_missing_behavior": {"const": "no_style"},
        "status_exclusions": {"$ref": "#/$defs/stringList"},
        "legacy_reference": {"type": "string", "minLength": 1},
        "target_selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetSelector"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
