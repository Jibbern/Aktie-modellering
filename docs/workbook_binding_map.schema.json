{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stockmodel/workbook_binding_map.schema.json",
  "title": "Workbook Binding Map",
  "type": "object",
  "required": ["version", "binding_planner_contract_version", "bindings"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "version": {"type": "string", "const": "0.3.0"},
    "description": {"type": "string"},
    "binding_planner_contract_version": {"type": "string", "const": "1.2.0"},
    "binding_planner_policy": {"type": "object"},
    "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}}
  },
  "$defs": {
    "rowSelector": {
      "type": "object",
      "required": ["source_path"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "pick": {"enum": ["all", "latest", "first"]},
        "pick_exclusion_disposition": {"enum": ["expected_supersession", "expected_priority_selection", "possible_ambiguity"]},
        "window": {"enum": ["all", "latest_capacity"]},
        "filters": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "targetColumn": {
      "type": "object",
      "required": ["source_field", "target_column"],
      "properties": {
        "column_id": {"type": "string"},
        "source_field": {"type": "string", "minLength": 1},
        "target_column": {"type": "string", "pattern": "^[A-Z]+$"},
        "target_type": {"type": "string"},
        "target_role": {"type": "string"}
      },
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "required": [
        "binding_id",
        "sheet",
        "section",
        "target",
        "normalized_field",
        "value_shape",
        "required",
        "source_policy",
        "missing_source_behavior",
        "promotion_requirement",
        "validation_rule",
        "writable"
      ],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "target": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(?::[A-Z]+[1-9][0-9]*)?$"},
        "planner_target": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(?::[A-Z]+[1-9][0-9]*)?$"},
        "normalized_field": {"type": "string", "minLength": 1},
        "value_shape": {"enum": ["scalar", "quarterly_series", "annual_series", "pivot_matrix", "table_rows", "text_block", "validation_rows"]},
        "required": {"type": "boolean"},
        "source_policy": {"type": "string", "minLength": 1},
        "missing_source_behavior": {"type": "string", "minLength": 1},
        "promotion_requirement": {"type": "string", "minLength": 1},
        "validation_rule": {"type": "string", "minLength": 1},
        "writable": {"type": "boolean"},
        "capacity": {"type": "integer", "minimum": 0},
        "overflow_behavior": {"enum": ["fail", "mapping_gap", "manual_review", "audit_only"]},
        "row_selector": {"$ref": "#/$defs/rowSelector"},
        "row_key": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sort_order": {"type": "array"},
        "required_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "target_columns": {"type": "array", "items": {"$ref": "#/$defs/targetColumn"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
