{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stockmodel/workbook_binding_map.schema.json",
  "title": "Workbook Binding Map",
  "type": "object",
  "required": [
    "version",
    "binding_planner_contract_version",
    "module_manifest_version",
    "module_contract_version",
    "module_profile_id",
    "module_manifest_signature",
    "module_profile_signature",
    "enabled_modules",
    "profile_pack_ids",
    "scenario_profile_packs",
    "bindings"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "version": {"type": "string", "const": "0.3.0"},
    "description": {"type": "string"},
    "binding_planner_contract_version": {"type": "string", "const": "1.3.0"},
    "module_manifest_version": {"type": "string", "const": "1.0.0"},
    "module_contract_version": {"type": "string", "const": "1.1.0"},
    "module_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "module_manifest_signature": {"$ref": "#/$defs/sha256"},
    "module_profile_signature": {"$ref": "#/$defs/sha256"},
    "enabled_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "profile_pack_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "scenario_profile_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenarioProfilePack"}
    },
    "binding_planner_policy": {"type": "object"},
    "financial_field_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/financialFieldDisposition"},
      "uniqueItems": true
    },
    "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}}
  },
  "$defs": {
    "scenarioProfilePack": {
      "type": "object",
      "required": ["profile_pack_id", "scenario_driver_ids"],
      "properties": {
        "profile_pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "scenario_driver_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      },
      "additionalProperties": false
    },
    "financialFieldDisposition": {
      "type": "object",
      "required": ["section", "field", "disposition", "reason"],
      "properties": {
        "section": {"enum": ["quarterly_financials", "annual_financials"]},
        "field": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["formula_owned", "audit_only", "explicitly_excluded"]},
        "reason": {"type": "string", "minLength": 1},
        "formula_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "rowSelector": {
      "type": "object",
      "required": ["source_path"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "pick": {"enum": ["all", "latest", "first"]},
        "pick_exclusion_disposition": {"enum": ["expected_supersession", "expected_priority_selection", "possible_ambiguity"]},
        "window": {"enum": ["all", "latest_capacity"]},
        "filters": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "targetColumn": {
      "type": "object",
      "required": ["source_field", "target_column"],
      "properties": {
        "column_id": {"type": "string"},
        "source_field": {"type": "string", "minLength": 1},
        "target_column": {"type": "string", "pattern": "^[A-Z]+$"},
        "target_type": {"type": "string"},
        "target_role": {"type": "string"}
      },
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "required": [
        "binding_id",
        "module_id",
        "sheet",
        "section",
        "target",
        "normalized_field",
        "value_shape",
        "required",
        "source_policy",
        "missing_source_behavior",
        "promotion_requirement",
        "validation_rule",
        "writable"
      ],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "sheet": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "target": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(?::[A-Z]+[1-9][0-9]*)?$"},
        "planner_target": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(?::[A-Z]+[1-9][0-9]*)?$"},
        "normalized_field": {"type": "string", "minLength": 1},
        "value_shape": {"enum": ["scalar", "quarterly_series", "annual_series", "pivot_matrix", "table_rows", "text_block", "validation_rows"]},
        "required": {"type": "boolean"},
        "source_policy": {"type": "string", "minLength": 1},
        "missing_source_behavior": {"type": "string", "minLength": 1},
        "promotion_requirement": {"type": "string", "minLength": 1},
        "validation_rule": {"type": "string", "minLength": 1},
        "writable": {"type": "boolean"},
        "capacity": {"type": "integer", "minimum": 0},
        "overflow_behavior": {"enum": ["fail", "mapping_gap", "manual_review", "audit_only"]},
        "row_selector": {"$ref": "#/$defs/rowSelector"},
        "row_key": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sort_order": {"type": "array"},
        "required_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "target_columns": {"type": "array", "items": {"$ref": "#/$defs/targetColumn"}}
      },
      "additionalProperties": true
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
